# Images: cache aggressively — filenames don't change when content does,
# but browsers will still check back periodically. A year-long cache with
# revalidation means repeat visitors load pages almost instantly.
/*/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: don't cache — content here (especially the news pages,
# now pulling live editorial posts) should always be current.
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# /admin is a reverse proxy to the Agent Portal (see netlify.toml). Netlify's
# edge has been observed caching this proxied response for a long TTL
# regardless of the upstream's own no-cache headers, serving a stale Agent
# build indefinitely. Force it explicitly on this project's own edge.
/admin
  Cache-Control: no-cache, no-store, must-revalidate
/admin/
  Cache-Control: no-cache, no-store, must-revalidate
/admin/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/admin/api/*
  Cache-Control: no-cache, no-store, must-revalidate
# DaySilk, the storage tool and the model sign-in page are plain pages inside /admin: never serve an old copy
/admin/daysilk/*
  Cache-Control: no-cache, no-store, must-revalidate
/admin/model-invites/*
  Cache-Control: no-cache, no-store, must-revalidate
/admin/storage-shrink/*
  Cache-Control: no-cache, no-store, must-revalidate
# Portal scripts/styles are loaded with a ?v= release stamp, but not every file's stamp changes
# when the file does. A one-hour cache therefore kept some pages on the old script while others
# had the new one (calendar, DaySilk and tasks disagreeing for up to an hour after a release).
# One minute is long enough to avoid re-downloading ~150 files on every click and short enough
# that a release reaches everyone together; after that the browser only asks "changed?" (a 304).
/admin/assets/*
  Cache-Control: public, max-age=60, must-revalidate
/admin/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/admin/assets/backdrops/*
  Cache-Control: public, max-age=604800
