# Images: cache aggressively — filenames don't change when content does,
# but browsers will still check back periodically. A year-long cache with
# revalidation means repeat visitors load pages almost instantly.
/*/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: don't cache — content here (especially the news pages,
# now pulling live editorial posts) should always be current.
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# /admin is a reverse proxy to the Agent Portal (see netlify.toml). Netlify's
# edge has been observed caching this proxied response for a long TTL
# regardless of the upstream's own no-cache headers, serving a stale Agent
# build indefinitely. Force it explicitly on this project's own edge.
/admin
  Cache-Control: no-cache, no-store, must-revalidate
/admin/
  Cache-Control: no-cache, no-store, must-revalidate
/admin/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/admin/api/*
  Cache-Control: no-cache, no-store, must-revalidate
# Portal scripts/styles/fonts are all loaded with a ?v= release stamp, so a
# new release is a new URL. Letting browsers keep them means the ~150 files
# the portal needs are not re-downloaded on every visit (this was the slowness).
/admin/assets/*
  Cache-Control: public, max-age=3600
/admin/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/admin/assets/backdrops/*
  Cache-Control: public, max-age=604800
